{
  "baseUrl": "https://your-site.com",

  "contractMode": "basic",

  "_comment_basic": "Generated by the Basic wizard (npx seo-setup → Basic). All 6 checks use `mode: \"basic\"` — existence / minimum-length, not exact-value matching. One shared template applies to every page, so pages don't carry per-page `seo` overrides. Switch to Custom any time by re-running the wizard.",

  "sampleConfig": {
    "maxPagesPerTemplate": 5
  },

  "templates": {
    "all": {
      "urlPattern": ".*",
      "waitForReady": "networkidle",
      "seo": {
        "metadata": {
          "title": { "enabled": true, "severity": "warning", "mode": "basic", "minLength": 10 },
          "metaDescription": { "enabled": true, "severity": "warning", "mode": "basic", "minLength": 50 },
          "h1": { "enabled": true, "severity": "warning", "mode": "basic", "minLength": 1 },
          "canonical": { "enabled": true, "severity": "warning", "mode": "basic" },
          "metaRobots": { "enabled": true, "severity": "blocker", "mode": "basic" },
          "hreflang": { "enabled": true, "severity": "warning", "mode": "basic" }
        },
        "httpChecks": {
          "xRobotsTag": { "enabled": true, "severity": "blocker", "mode": "basic" }
        }
      }
    }
  },

  "pages": [
    { "path": "/", "template": "all", "description": "Home page" },
    { "path": "/about", "template": "all", "description": "/about" },
    { "path": "/contact", "template": "all", "description": "/contact" }
  ]
}
